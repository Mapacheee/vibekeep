# Set these in your shell, or start with node --env-file=/path/to/private.env dist/src/cli.js
# OpenAI-compatible endpoint with chat completions and tool calling support:
VIBEKEEP_PROVIDER=compatible
VIBEKEEP_BASE_URL=http://localhost:1234/v1
VIBEKEEP_MODEL=your-tool-capable-model-id
# VIBEKEEP_API_KEY=your-private-key
# Alternatively: VIBEKEEP_PROVIDER=anthropic, VIBEKEEP_MODEL=..., VIBEKEEP_API_KEY=...
