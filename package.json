{
  "name": "vibekeep",
  "version": "0.2.0",
  "private": true,
  "description": "Project memory and team coordination for AI-assisted work.",
  "type": "module",
  "bin": {
    "vibekeep": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "ui",
    "examples",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "npm run build && node --test dist/test/browser/*.e2e.js",
    "start": "node dist/src/cli.js",
    "dev": "npm run build && node dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mapacheee/vibekeep.git"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xmldom/xmldom": "^0.9.12",
    "ai": "^7.0.173",
    "ajv": "^8.20.0",
    "cross-spawn": "^7.0.6",
    "ignore": "^7.0.14",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
